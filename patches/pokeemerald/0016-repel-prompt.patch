Pokémon Emerald 3Ds Dual Screen changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: another Repel when one wears off
Applies after 0015-ivs-evs.patch; apply with tools/bootstrap.py.

diff --git a/data/scripts/repel.inc b/data/scripts/repel.inc
--- a/data/scripts/repel.inc
+++ b/data/scripts/repel.inc
@@ -1,6 +1,32 @@
 EventScript_RepelWoreOff::
+	@ Repel prompt (OPTIONS, ENHANCEMENTS): another of the last Repel used?
+	special ShouldOfferAnotherRepel
+	goto_if_eq VAR_RESULT, FALSE, EventScript_RepelWoreOffOnly
+	lockall
+	bufferitemname STR_VAR_1, VAR_LAST_REPEL
+	msgbox Text_RepelWoreOffUseAnother, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, EventScript_RepelWoreOffDone
+	removeitem VAR_LAST_REPEL
+	special SetRepelStepsFromLastRepel
+	playse SE_REPEL
+	msgbox Text_UsedAnotherRepel, MSGBOX_DEFAULT
+	waitse
+EventScript_RepelWoreOffDone:
+	closemessage
+	releaseall
+	end
+
+EventScript_RepelWoreOffOnly:
 	msgbox Text_RepelWoreOff, MSGBOX_SIGN
 	end
 
 Text_RepelWoreOff:
 	.string "REPEL's effect wore off…$"
+
+Text_RepelWoreOffUseAnother:
+	.string "REPEL's effect wore off…\p"
+	.string "Use another {STR_VAR_1}?$"
+
+Text_UsedAnotherRepel:
+	.string "{PLAYER} used the\n"
+	.string "{STR_VAR_1}.$"
