Pokémon Emerald 3Ds Dual Screen changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: the POKéDEX in meters and kilograms for Portuguese
Applies after 0054-portuguese-option-menu-columns.patch; apply with tools/bootstrap.py.

diff --git a/src/pokedex.c b/src/pokedex.c
--- a/src/pokedex.c
+++ b/src/pokedex.c
@@ -4282,11 +4282,11 @@
 
 static void PrintMonHeight(u16 height, u8 left, u8 top)
 {
-#if defined(PORT_BRIDGE) && (GAME_LANGUAGE == LANGUAGE_SPANISH || GAME_LANGUAGE == LANGUAGE_FRENCH)
+#if defined(PORT_BRIDGE) && (GAME_LANGUAGE == LANGUAGE_SPANISH || GAME_LANGUAGE == LANGUAGE_FRENCH || CTR_LANG_PT_BR)
     u8 buffer[16];
     u8 *end = ConvertIntToDecimalStringN(buffer, height / 10, STR_CONV_MODE_LEFT_ALIGN, 4);
 
-#if GAME_LANGUAGE == LANGUAGE_FRENCH
+#if GAME_LANGUAGE == LANGUAGE_FRENCH || CTR_LANG_PT_BR
     *end++ = CHAR_COMMA;
 #else
     *end++ = CHAR_PERIOD;
@@ -4331,11 +4331,11 @@
 
 static void PrintMonWeight(u16 weight, u8 left, u8 top)
 {
-#if defined(PORT_BRIDGE) && (GAME_LANGUAGE == LANGUAGE_SPANISH || GAME_LANGUAGE == LANGUAGE_FRENCH)
+#if defined(PORT_BRIDGE) && (GAME_LANGUAGE == LANGUAGE_SPANISH || GAME_LANGUAGE == LANGUAGE_FRENCH || CTR_LANG_PT_BR)
     u8 buffer[16];
     u8 *end = ConvertIntToDecimalStringN(buffer, weight / 10, STR_CONV_MODE_LEFT_ALIGN, 4);
 
-#if GAME_LANGUAGE == LANGUAGE_FRENCH
+#if GAME_LANGUAGE == LANGUAGE_FRENCH || CTR_LANG_PT_BR
     *end++ = CHAR_COMMA;
 #else
     *end++ = CHAR_PERIOD;
