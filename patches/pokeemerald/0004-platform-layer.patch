+    s16 pb = getBgPB(bgNum);
+    s16 pc = getBgPC(bgNum);
+    s16 pd = getBgPD(bgNum);
+
+    int sizeX = 128;
+    int sizeY = 128;
+
+    switch (bgcnt->screenSize)
+    {
+    case 0:
+        break;
+    case 1:
+        sizeX = sizeY = 256;
+        break;
+    case 2:
+        sizeX = sizeY = 512;
+        break;
+    case 3:
