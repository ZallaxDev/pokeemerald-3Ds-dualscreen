+    unsigned int screenBaseBlock = bgcnt->screenBaseBlock;
+    unsigned int mapWidth = 1 << (4 + (bgcnt->screenSize)); // number of tiles
+
+    uint8_t *bgtiles = (uint8_t *)(VRAM_ + charBaseBlock * 0x4000);
