+                //if (pixel != 0)
+                writeBgPixel(pixel, x)
+                x += 1;
+            }
+        }
+        else
+        {
+            for (int i = visibleTilePixels; i < 8; i++)
+            {
+                pixel = bgtiles[tileLoc + (i/2)];
+
+                if (i & 1)
+                    pixel >>= 4;
+                else
+                    pixel &= 0xF;
